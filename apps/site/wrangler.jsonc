// Worker do Cloudflare para o site publico, montado pelo OpenNext.
//
// Sem "name" de proposito: no Workers Builds (deploy pelo GitHub) o nome
// do Worker vem do nome do projeto criado no painel. Fixar um nome aqui
// que nao batesse com o do projeto fazia o deploy falhar. O dominio e
// ligado no painel: Workers > (seu projeto) > Settings > Domains & Routes.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Otimizacao das fotos do next/image via Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
