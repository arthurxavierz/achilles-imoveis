{
  "name": "achilles-imoveis",
  "private": true,
  "version": "2.0.0",
  "description": "Plataforma da Achilles Imoveis. Site publico + sistema de gestao.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "npm run dev --workspace @imob/site",
    "dev:app": "npm run dev --workspace @imob/app",
    "build:site": "npm run build --workspace @imob/site",
    "build:app": "npm run build --workspace @imob/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:types": "supabase gen types typescript --linked > packages/db/src/database.types.ts",
    "assets": "node scripts/sincronizar-assets.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
